{
  "name": "wedding",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-19",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/uploads/*", "/admin*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "WEDDING_DATA", "class_name": "WeddingData" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WeddingData"] }],
  "r2_buckets": [{ "binding": "WEDDING_UPLOADS" }]
}
